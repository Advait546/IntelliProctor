# Copy to backend/.env. Every value has a working local default; the backend
# runs with no .env at all (SQLite + local evidence storage + in-process pub/sub).

APP_ENV=development
PORT=8000

# Local runtime data (SQLite file, evidence images, generated secret key).
# Default: %LOCALAPPDATA%\IntelliProctor on Windows (kept OUT of OneDrive),
# backend/data elsewhere.
# DATA_DIR=

# --- Database -----------------------------------------------------------------
# Unset -> SQLite file in the data directory (zero setup).
# PostgreSQL 16 (recommended, BACKEND_ARCHITECTURE.md 20.1):
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelliproctor
# Supabase: Project Settings -> Database -> Connection string (URI). Paste it as-is;
# postgres:// / postgresql:// URLs are upgraded to the asyncpg driver automatically.
#   DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Run `alembic upgrade head` automatically at startup.
DB_AUTO_MIGRATE=true

# --- Redis (optional) ---------------------------------------------------------
# Unset -> in-process live bus + idempotency cache (fine for one uvicorn process).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Evidence object storage (optional) ---------------------------------------
# Unset -> private <data dir>/storage/ folder served only via signed 15-min URLs.
# MinIO (docker compose up -d) or AWS S3:
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_EVIDENCE=intelliproctor-evidence
# S3_SERVER_SIDE_ENCRYPTION=AES256   # AWS only
S3_ENDPOINT_URL=

# --- Auth ---------------------------------------------------------------------
# Unset -> a random 64-byte key is generated once into <data dir>/.secret_key.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true when serving over HTTPS
COOKIE_SECURE=false
# Allow anyone to self-register as an examiner (otherwise only the very first
# examiner may self-register; create more with `python -m src.seed create-examiner`).
ALLOW_EXAMINER_SIGNUP=false

# Vite dev server origin(s)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CV inference worker -------------------------------------------------------
PROCTOR_SERVICE_URL=http://localhost:8001
# Must match INTERNAL_SERVICE_TOKEN in proctoring-service/.env
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Demo examiner/candidate/exam on an empty database (see src/seed.py).
SEED_DEMO_DATA=true
