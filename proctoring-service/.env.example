# Copy to proctoring-service/.env (optional -- every value has a default).

# Shared secret: must equal INTERNAL_SERVICE_TOKEN in backend/.env. Only the
# backend may call /analyze.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Detection phase. phase0 (pretrained models/pretrained/yolo11m.pt) is the ONLY
# production-approved model -- see reports/ml/PHASE3_POST_PROCESSING_REVIEW.md.
#   phase0_baseline | phase0 (default) | phase2_gpu (research only) | iteration2
INTELLIPROCTOR_PHASE=phase0

# auto (GPU if torch sees CUDA, else CPU) | cpu | cuda | 0
PROCTOR_DEVICE=auto

# YOLO letterbox size. 1280 is the validated production setting (small phones);
# 640 is ~3x faster on CPU at some recall cost for small/distant objects.
PROCTOR_IMGSZ=1280

# true: YOLO runs on a background worker thread (decoupled from MediaPipe);
# false: YOLO runs inline on every request (debugging only).
PROCTOR_YOLO_ASYNC=true
