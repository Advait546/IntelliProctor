# Comma-separated list of origins allowed to call this service directly
# (only matters if you ever hit it from a browser instead of only from the
# Node backend). The Node backend's own server-to-server fetch calls are not
# subject to CORS at all.
CORS_ORIGIN=http://localhost:8000,http://localhost:5173

# Which detection phase to load at startup. See app/detector.py's
# PHASE_CONFIGS / PHASE_ALIASES for the full list and
# reports/ml/PHASE3_POST_PROCESSING_REVIEW.md for why "phase0" (the pretrained
# baseline, NOT the fine-tuned Iteration 1 model) is the production default.
#   phase0_baseline -> original strict pretrained-model thresholds
#   phase0          -> optimized pretrained-model thresholds (DEFAULT)
#   phase2_gpu (aliases: phase1, phase2) -> fine-tuned Iteration 1 model --
#                      NOT approved for production, selectable for comparison only
#   iteration2      -> placeholder for a future model, not yet trained
INTELLIPROCTOR_PHASE=phase0

# "cpu" or "0" (first CUDA device). video_input_analysis.py's own validated
# latency benchmark that cleared the Phase 2 gate was measured on CPU, so CPU
# is the safe default; only switch this if you've separately validated GPU
# inference for your deployment.
PROCTOR_DEVICE=cpu
