# Copy this file to .env and fill in your real values. Never commit .env.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
# Service role key (secret!) -- this lets the server bypass RLS. Never expose
# this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string. Used to sign admin/student JWTs.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Port the Express API listens on. Kept at 8000 to match the default
# VITE_API_BASE_URL already set in src/api/client.js (http://localhost:8000/api/v1) --
# change both together if you use a different port.
PORT=8000

# Where the Python proctoring microservice is running.
PROCTOR_SERVICE_URL=http://localhost:8001

# Comma-separated list of origins allowed to call this API (your Vite dev server).
CORS_ORIGIN=http://localhost:5173
