# ==============================================================================
# IntelliProctor — Comprehensive Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode & Compilation Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.manifest
*.spec

# Distribution / Packaging
build/
dist/
eggs/
*.egg-info/
*.egg

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Application (Frontend/)
# ------------------------------------------------------------------------------
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
Frontend/.local/

# NPM / Yarn / PNPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Testing, Quality & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.oxlintrc.cache
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 5. Computer Vision & YOLO Machine-Generated Artifacts
# ------------------------------------------------------------------------------
# Ultralytics training runs, checkpoints, and evaluations (~7+ GB)
runs/
scratch/

# Binary label caches generated by Ultralytics across all dataset directories
*.cache
*.cache.npy
labels/*.cache
dataset/**/labels/*.cache
Dataset_it2/**/labels/*.cache
Dataset_it2_augmented/
Dataset_it2/images/

# Temporary / diagnostic model weights dumped in root
# (Curated weights are organized in models/pretrained/ and models/trained/)
/yolo*.pt
/yolo26n.pt

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Files
# ------------------------------------------------------------------------------
# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor / IDE configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# 7. Model Binary Management (Git LFS)
# ------------------------------------------------------------------------------
# Large model checkpoints (*.pt) are tracked via Git LFS in .gitattributes:
#   *.pt filter=lfs diff=lfs merge=lfs -text
# Note: Root temporary weights are ignored above to prevent accidental bloat.